{
  "name": "pagent-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/shell/tsconfig.json",
    "compile-all": "node scripts/check.ts",
    "test": "node --import ./test/lib/register.ts --test 'test/unit/*.test.ts' 'test/smoke/*.test.ts'",
    "e2e": "node --test 'test/e2e/*.test.ts'",
    "check": "node --run typecheck && node --run compile-all && node --run test && node --run e2e"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
